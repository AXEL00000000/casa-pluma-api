NODE_ENV=development
PORT=3000
SERVICE_NAME=Casa Pluma API

# Cadena de conexión de Supabase: Project Settings > Database > Connection string (URI).
# Usa el "Session pooler" si tu red no tiene IPv6.
URL_DB=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_SSL=true
# Esquema donde se crean las tablas (permite compartir la base con otros proyectos)
DB_SCHEMA=casa_pluma

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-bytes

# Usuario que crea `npm run db:init`
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Origen del front (Vite)
CORS_ORIGIN=http://localhost:5173
